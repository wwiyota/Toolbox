{
  "manifest_version": 3,
  "name": "Tool Box",
  "version": "0.1.0",
  "description": "色々な便利機能を追加していく予定です。",
  "permissions": [
    "contextMenus",
    "tabs",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "webRequest"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service/service_worker.js"
  },
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["contents/content.js", "contents/jquery-3.4.1.min.js", "contents/toast.js"],
      "run_at": "document_idle",
      "css": ["contents/styles/custom_style.css"]
    },
    {
      "matches": ["https://ssl.wf.jobcan.jp/*"],
      "js": ["contents/jobcan_wf_content.js"],
      "run_at": "document_idle"
    }
  ]
}
